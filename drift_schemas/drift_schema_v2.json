      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"halaqahs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"teacher_name\" TEXT NOT NULL, \"halaqah_name\" TEXT NOT NULL, \"center_name\" TEXT NOT NULL, \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL, CHECK (length(trim(teacher_name)) > 0), CHECK (length(trim(halaqah_name)) > 0), CHECK (length(trim(center_name)) > 0));"
        }
      ]
    },
    {
      "name": "support_program_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"support_program_settings\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"halaqah_id\" INTEGER NOT NULL REFERENCES halaqahs (id) ON DELETE RESTRICT, \"status\" TEXT NOT NULL, \"organization_name\" TEXT NULL, \"created_at_utc\" TEXT NOT NULL, \"updated_at_utc\" TEXT NOT NULL, UNIQUE (\"halaqah_id\"), CHECK (status IN ('disabled', 'pending_activation', 'enabled')), CHECK ((status = 'disabled' AND organization_name IS NULL) OR (status IN ('pending_activation', 'enabled') AND organization_name IS NOT NULL AND length(trim(organization_name)) > 0)));"
        }
      ]
    },
    {
      "name": "support_program_periods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"support_program_periods\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"halaqah_id\" INTEGER NOT NULL REFERENCES halaqahs (id) ON DELETE RESTRICT, \"organization_name\" TEXT NOT NULL, \"started_at_utc\" TEXT NOT NULL, \"ended_at_utc\" TEXT NULL, CHECK (length(trim(organization_name)) > 0), CHECK (ended_at_utc IS NULL OR ended_at_utc > started_at_utc));"
